{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tessera",
  "version": "0.4.0",
  "identifier": "cloud.privum.tessera",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1431",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tessera",
        "width": 460,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Open-source authenticator for Linux",
    "longDescription": "Tessera generates TOTP and HOTP codes, imports accounts from Google Authenticator, and synchronises an encrypted vault through your Google account.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4M0FBQTVFQzMxNEFBN0UKUldSK3FoVERYcW82NkxsZTE1R2lDQmtPZ0prbGNla05rdHM4Ym5tcm5JNmFqaTl0bzZsblBXaVIK",
      "endpoints": [
        "https://github.com/privum-cloud/tessera-mfa-app/releases/latest/download/latest.json"
      ]
    }
  }
}
